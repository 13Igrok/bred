wrap;html=1;#FBEFC4;strokeColor=#B8860B;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="RADIUS 1812/1813 + DHCP&lt;br&gt;160.102 · BGInet 1951"><mxGeometry x="1910" y="260" width="450" height="70" as="geometry"/></mxCell><mxCell id="n54" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#FBEFC4;strokeColor=#B8860B;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="Ядро BGBilling 160.101&lt;br&gt;ActiveMQ :61616 (CVE-2023-46604) · JSP 8080"><mxGeometry x="1910" y="350" width="450" height="80" as="geometry"/></mxCell><mxCell id="n55" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="ProxySQL 160.103&lt;br&gt;:6033 · admin 6032/6070/6080 открыты"><mxGeometry x="1910" y="450" width="450" height="70" as="geometry"/></mxCell><mxCell id="n56" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="PXC 160.194-196&lt;br&gt;MySQL 5.7.44 EOL"><mxGeometry x="1910" y="540" width="450" height="70" as="geometry"/></mxCell><mxCell id="n57" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F9E0EC;strokeColor=#C2418E;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="Call-центр&lt;br&gt;161.13"><mxGeometry x="1910" y="630" width="450" height="60" as="geometry"/></mxCell><mxCell id="e58" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5A6672;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n52" target="n53" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e59" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5A6672;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n53" target="n54" value="RADIUS"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e60" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5A6672;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n54" target="n55" value=""><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e61" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5A6672;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n55" target="n56" value="SQL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e62" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#5A6672;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n54" target="n57" value="AMI/SIP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h63" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Цепочка:&lt;/b&gt; Абонент → BRAS/NAS → RADIUS 1812/1813 + DHCP → ActiveMQ :61616 → Ядро BGBilling → ProxySQL :6033 → Percona XtraDB 5.7.44 (3 ноды + лог-нода)&lt;br&gt;&amp;nbsp;&amp;nbsp;↘ CoA :3799 → BRAS &amp;nbsp;&amp;nbsp; ↘ FTP каждые 20–30 мин → ПУ СОРМ-3 &amp;nbsp;&amp;nbsp; ↘ ЛК абонента (nginx на ядре) · API Gateway (K3s :8080) · BGERP (SOAP :8080)&lt;br&gt;&lt;b&gt;Правило отказа:&lt;/b&gt; ядро лежит — авторизованные работают; БД/RADIUS лежит — новые авторизации не проходят. Рестарт RADIUS = 5–10 мин Reject всем абонентам."><mxGeometry x="50" y="720" width="1500" height="90" as="geometry"/></mxCell><mxCell id="h64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;КРИТ:&lt;/b&gt; ActiveMQ CVE-2023-46604 (CVSS 10.0) на всех 5 bg-core, OpenWire 61616 наружу, Java от root.&lt;br&gt;&lt;b&gt;Дефекты:&lt;/b&gt; обещанный платёж IVR выдаёт сутки (не 5); «Заморозка» тарифицируется при отриц. балансе (~529 тыс ₽ ЮТК за 2 года); PaymentInboxListener не активен; API Gateway доля unknown-метрик 62% rocket / 44% omiplat."><mxGeometry x="50" y="830" width="1500" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d-03-Базы-данных-PXC-ProxySQL" name="03 · Базы данных · PXC + ProxySQL"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;fontColor=#111111;" vertex="1" parent="1" value="БАЗЫ ДАННЫХ: 6 независимых 3-нодовых кластеров Percona XtraDB (Galera) + ProxySQL"><mxGeometry x="40" y="20" width="2100" height="34" as="geometry"/></mxCell><mxCell id="t2" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#555555;" vertex="1" parent="1" value="erp — MySQL 8.0.43-34.1, остальные пять — 5.7.44-48-57 (EOL). Proxysql 2.4.4–2.5.1 (admin-интерфейсы в сети). Инцидент dbnode2 (RAID10) закрыт 09.07.2026, процедура восстановления в Wiki."><mxGeometry x="40" y="58" width="2100" height="34" as="geometry"/></mxCell><mxCell id="n3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PXC erp&lt;/b&gt;&lt;br&gt;192.168.161.21 / .22 / .23&lt;br&gt;MySQL 8.0.43-34.1"><mxGeometry x="60" y="120" width="620" height="80" as="geometry"/></mxCell><mxCell id="n4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="кластер НЕ используется BGERP (ходит на localhost 8.0.28)"><mxGeometry x="710" y="120" width="600" height="80" as="geometry"/></mxCell><mxCell id="n5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PXC flash&lt;/b&gt;&lt;br&gt;192.168.160.189 / .191 / .193&lt;br&gt;MySQL 5.7.44 EOL"><mxGeometry x="60" y="220" width="620" height="80" as="geometry"/></mxCell><mxCell id="n6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="ProxySQL 110.20"><mxGeometry x="710" y="220" width="600" height="80" as="geometry"/></mxCell><mxCell id="n7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PXC omiplat&lt;/b&gt;&lt;br&gt;192.168.160.126 / .198 / .199 (лог .127)&lt;br&gt;MySQL 5.7.44 EOL"><mxGeometry x="60" y="320" width="620" height="80" as="geometry"/></mxCell><mxCell id="n8" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="ProxySQL 160.70 (верифицирован)"><mxGeometry x="710" y="320" width="600" height="80" as="geometry"/></mxCell><mxCell id="n9" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PXC rocket&lt;/b&gt;&lt;br&gt;192.168.160.128 / .129 / .130 (лог .131)&lt;br&gt;MySQL 5.7.44 EOL"><mxGeometry x="60" y="420" width="620" height="80" as="geometry"/></mxCell><mxCell id="n10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="ProxySQL 172.16.100.26 — НЕ проверен"><mxGeometry x="710" y="420" width="600" height="80" as="geometry"/></mxCell><mxCell id="n11" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PXC rtc&lt;/b&gt;&lt;br&gt;192.168.160.132 / .133 / .134&lt;br&gt;MySQL 5.7.44 EOL"><mxGeometry x="60" y="520" width="620" height="80" as="geometry"/></mxCell><mxCell id="n12" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="ProxySQL 160.89"><mxGeometry x="710" y="520" width="600" height="80" as="geometry"/></mxCell><mxCell id="n13" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PXC utk/omicron&lt;/b&gt;&lt;br&gt;192.168.160.194 / .195 / .196 (лог .197)&lt;br&gt;MySQL 5.7.44 EOL"><mxGeometry x="60" y="620" width="620" height="80" as="geometry"/></mxCell><mxCell id="n14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#EADCF9;strokeColor=#7B4FC9;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="ProxySQL 160.103"><mxGeometry x="710" y="620" width="600" height="80" as="geometry"/></mxCell><mxCell id="h15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F0FA;strokeColor=#7B4FC9;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Прочее:&lt;/b&gt;&lt;br&gt;• ProxySQL omiplat 192.168.160.70:6033 — HG10/HG20/HG30, max_writers=1 — единственный верифицированный.&lt;br&gt;• Лог-ноды PXC (.127/.131/.197) live не проверялись.&lt;br&gt;• db-backup1/2 160.135/.136 — /db-backups ПУСТ (0 файлов) — КРИТ №1.&lt;br&gt;• dbnode1–3 — локальный RAID10 под PXC; 6 нод БД разнесены по 3 хостам.&lt;br&gt;• MySQL BGERP — standalone 8.0.28 на 127.0.0.1 (160.31), без репликации.&lt;br&gt;• Postgres sogo-db (K3s Longhorn PVC) — БД веб-почты."><mxGeometry x="1350" y="120" width="780" height="480" as="geometry"/></mxCell><mxCell id="h16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Инцидент dbnode2:&lt;/b&gt; потеря RAID10-датастора уронила все 6 node2. Требования: версии бит-в-бит, два набора SSL (SST vs Galera), копировать mysqld.cnf (иначе buffer pool 128M вместо 16G), донор node3, зависавший xtrabackup-v2 обошли через wsrep_sst_method=rsync, bootstrap по grastate.dat."><mxGeometry x="60" y="740" width="1240" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d-04-Почта-и-DNS" name="04 · Почта и DNS"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;fontColor=#111111;" vertex="1" parent="1" value="ПОЧТА и DNS"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="n2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DCE9F7;strokeColor=#1F6FEB;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Интернет&lt;/b&gt;"><mxGeometry x="60" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="n3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DDF3F3;strokeColor=#0E8A8A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;relay1&lt;/b&gt; 192.168.161.32 / 185.221.44.9&lt;br&gt;MX 10 · STARTTLS истёк 14.05.2026"><mxGeometry x="360" y="100" width="460" height="70" as="geometry"/></mxCell><mxCell id="n4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DDF3F3;strokeColor=#0E8A8A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;relay2&lt;/b&gt; 192.168.161.33 / 185.221.44.17&lt;br&gt;MX 15"><mxGeometry x="870" y="100" width="400" height="70" as="geometry"/></mxCell><mxCell id="n5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DDF3F3;strokeColor=#0E8A8A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;K3s mailserver 15.1.0 + SOGo + Postgres&lt;/b&gt;&lt;br&gt;VIP 192.168.161.101 · NodePort 25→30025, 465→30465, 587→30587, 993→30553&lt;br&gt;471 ящик · том 704/788G (90%) · Longhorn 800Gi (Retain) · search fts_xapian 3–20 дней"><mxGeometry x="60" y="240" width="700" height="100" as="geometry"/></mxCell><mxCell id="n6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DDF3F3;strokeColor=#0E8A8A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;SOGo&lt;/b&gt;&lt;br&gt;веб-почта → traefik 31080&lt;br&gt;галерея objectClass=person &amp; mail=* (226 уволенных)"><mxGeometry x="800" y="240" width="420" height="100" as="geometry"/></mxCell><mxCell id="n7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#E3E3FF;strokeColor=#3B3B8F;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Exchange ×5 (Windows)&lt;/b&gt;&lt;br&gt;161.50, 161.92–95 · домены операторов&lt;br&gt;DC 160.91–95 · ВСЕ 100 копий Veeam провалены"><mxGeometry x="60" y="380" width="700" height="90" as="geometry"/></mxCell><mxCell id="n8" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DDF3F3;strokeColor=#0E8A8A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Postfix миграция K3s не завершена&lt;/b&gt;&lt;br&gt;relay1/relay2 развёрнуты, но поды 5 доменов масштабированы в 0 → релей ведёт на Exchange"><mxGeometry x="800" y="380" width="700" height="90" as="geometry"/></mxCell><mxCell id="n9" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F7C6C6;strokeColor=#B00020;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;dc1 192.168.160.60 (SPOF)&lt;/b&gt;&lt;br&gt;5 FSMO · LDAPS почты/Bitrix · DNS 110.x"><mxGeometry x="60" y="510" width="400" height="80" as="geometry"/></mxCell><mxCell id="n10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#E3E3FF;strokeColor=#3B3B8F;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;dc2 192.168.160.69&lt;/b&gt;&lt;br&gt;2022 · НЕ прописан в настройках почты"><mxGeometry x="500" y="510" width="400" height="80" as="geometry"/></mxCell><mxCell id="n11" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#DDF3F3;strokeColor=#0E8A8A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;PowerDNS ns1/ns2&lt;/b&gt;&lt;br&gt;161.18/.19 · 185.221.44.13/.37 · SSH 1221 · без бэкапа"><mxGeometry x="940" y="510" width="460" height="80" as="geometry"/></mxCell><mxCell id="h12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;360pro.online:&lt;/b&gt; MX 10 relay1 / 15 relay2 · SPF &lt;code&gt;ip4:185.221.44.9 ip4:185.221.44.17&lt;/code&gt; · DMARC &lt;code&gt;p=reject&lt;/code&gt; · DKIM &lt;code&gt;mail&lt;/code&gt;. Split-horizon: внешний PowerDNS, внутренний AD DNS (.loc).&lt;br&gt;&lt;b&gt;Проблемы:&lt;/b&gt; STARTTLS-сертификаты relay1/2 истекли 14.05.2026; том 88–90%; самоподписанный TLS; 204→226 учёток уволенных принимают почту; dc2 не прописан → при отказе dc1 вход в почту пропадает."><mxGeometry x="60" y="630" width="1340" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d-05-Телефония-и-колл-центры" name="05 · Телефония и колл-центры"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;fontColor=#111111;" vertex="1" parent="1" value="ТЕЛЕФОНИЯ И КОЛЛ-ЦЕНТРЫ"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="n2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F9E0EC;strokeColor=#C2418E;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Входящие SIP-транки&lt;/b&gt;&lt;br&gt;Манго (регистрация) · Билайн (по IP)"><mxGeometry x="60" y="100" width="400" height="70" as="geometry"/></mxCell><mxCell id="n3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F7C6C6;strokeColor=#B00020;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Старая АТС 192.168.160.35&lt;/b&gt;&lt;br&gt;Asterisk 11.6-cert18 · FreePBX 2.7 · Line24 ЦОВ&lt;br&gt;40 очередей · 158 агентов · CentOS 7 EOL"><mxGeometry x="540" y="100" width="520" height="90" as="geometry"/></mxCell><mxCell id="n4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F9E0EC;strokeColor=#C2418E;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Asterisk 21.6.0 / FreePBX 17 (PJSIP)&lt;/b&gt;&lt;br&gt;Flash 110.29 · РТЦ 110.30 · ЮТК 161.13 · Rocket 172.16.100.54 · Омиплат 160.217&lt;br&gt;без контакт-центра"><mxGeometry x="1120" y="100" width="640" height="90" as="geometry"/></mxCell><mxCell id="n5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F9E0EC;strokeColor=#C2418E;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;FOP2 192.168.161.11&lt;/b&gt; (2.31.47)&lt;br&gt;сломан после Debian 13 — «Demo Mode»"><mxGeometry x="60" y="250" width="400" height="70" as="geometry"/></mxCell><mxCell id="n6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F9E0EC;strokeColor=#C2418E;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;CDR ×6 серверов / 6 отдельных БД&lt;/b&gt;&lt;br&gt;сквозной отчёт одним запросом невозможен; CDR без бэкапа"><mxGeometry x="540" y="250" width="520" height="70" as="geometry"/></mxCell><mxCell id="n7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F9E0EC;strokeColor=#C2418E;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;ERP ↔ AMI «дозвон»&lt;/b&gt;&lt;br&gt;Zabbix → голосовые алерты (сервер 156.33 не отвечает)"><mxGeometry x="1120" y="250" width="640" height="70" as="geometry"/></mxCell><mxCell id="n8" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#ECECEC;strokeColor=#7A7A7A;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;SIP/порты:&lt;/b&gt; 5060/5061, RTP 10000–20000, IAX2 4569, AMI 5038, HTTP 8088/8089, H.323 1720, TFTP 69"><mxGeometry x="60" y="380" width="1000" height="60" as="geometry"/></mxCell><mxCell id="h9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Авария 31.08.2026:&lt;/b&gt; площадка 192.168.110.0/24 зависит только от внутренних DNS AD — на ~час пропали транк Манго и исходящие Flash, отклик ЛК биллинга вырос до 6 секунд.&lt;br&gt;&lt;b&gt;Бэкап записей звонков не работает с 09.11.2025&lt;/b&gt; (Permission denied publickey): записи 09.11.2025–13.03.2026 потеряны; ошибку видно только в root-почте, проверки свежести нет. У Flash/РТЦ транк Манго с регистрацией, у Билайна — по IP."><mxGeometry x="60" y="500" width="1700" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d-06-Виртуализация-vCenter-ESXi-СХД" name="06 · Виртуализация vCenter / ESXi / СХД"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;fontColor=#111111;" vertex="1" parent="1" value="ВИРТУАЛИЗАЦИЯ: VMware vSphere 6.7 (EOL) · MainDC · 3 кластера · 8 хостов · 171 ВМ · 16 датасторов"><mxGeometry x="40" y="20" width="2100" height="34" as="geometry"/></mxCell><mxCell id="t2" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacing=0;fontColor=#555555;" vertex="1" parent="1" value="Снято через vCenter API (vcsa 192.168.160.202) — HA выключен на всех кластерах; DRS: AC MAIN/AA DB fully/manual, Old servers — off. Все хосты ESXi 6.7.0 build 23084122, CONNECTED, не в maintenance."><mxGeometry x="40" y="58" width="2100" height="34" as="geometry"/></mxCell><mxCell id="n3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#D9E7F5;strokeColor=#2F6FB0;strokeWidth=2;fontSize=11;align=left;ver