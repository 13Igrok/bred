25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;171 ВМ:&lt;/b&gt; 140 включены / 31 выключены. Папки: vm 41, Discovered 28, 1C ALL 11, TestS 8, Exchange 7, Active Directory 7, CALLCENTER 6, NO_MONEY 5, core 5, radius 5, proxySQL 5. Гостевая ОС (по tools): Debian 10 в основном; 20 хостов на EOL-ОС, vSphere 6.7 EOL, WireGuard на CentOS 8.3.&lt;br&gt;&lt;b&gt;Риск:&lt;/b&gt; обе СХД HPE MSA sv4/sv5 в статусе Degraded, репликации нет — все ядра биллингов, ERP, Exchange, 1С на одном отказе."><mxGeometry x="60" y="640" width="1550" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d-07-Мониторинг-логирование-резервное-копирование" name="07 · Мониторинг, логирование, резервное копирование"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacing=0;fontColor=#111111;" vertex="1" parent="1" value="МОНИТОРИНГ · ЛОГИРОВАНИЕ · РЕЗЕРВНОЕ КОПИРОВАНИЕ"><mxGeometry x="40" y="20" width="1600" height="34" as="geometry"/></mxCell><mxCell id="n2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#F7C6C6;strokeColor=#B00020;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1" value="&lt;b&gt;Zabbix core 192.168.160.104&lt;/b&gt;&lt;br&gt;7.2.13 на PostgreSQL 14 · веб+server наружу → RCE&lt;br&gt;агенты 7.2.15 / 6.0.44 / 6.0.48"><mxGeometry x="60" y="100" width="450" height="80" as="geometry"/></mxCell><mxCell id="n3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;#E4F1D8;strokeColor=#5E8C31;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=6;fontFamily=H